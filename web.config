<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for: CFPASS 홈페이지 (원페이지 정적 사이트)
  Source: https://github.com/iYNz/cfpass-refine

  빌드 산출물이 없다 — 이 저장소를 그대로 사이트 루트에 두면 동작한다.
  Netlify 는 이 파일을 무시하므로 한 저장소에 함께 둔다.

  IIS 호스트 준비물
    - IIS 10+
    - Static Content · Default Document · HTTP Errors 기능 활성화
    - 앱 풀: "관리 코드 없음" (순수 정적 사이트, .NET 불필요)
    - URL Rewrite 모듈 불필요 (SPA 라우팅·클린 URL 미사용)

  옮길 때 주의
    개발 환경의 assets/img · assets/media 는 airpass-cfpass 로의 디렉터리
    정션이다. 탐색기 복사는 링크만 옮겨 깨지므로 git clone 또는
    robocopy /S 로 실제 파일을 받아야 한다.

  압축은 서버 기본값(text/* · application/javascript)에 맡긴다.
  <httpCompression> 은 서버 수준에서 잠겨 있는 경우가 많아
  web.config 에서 덮어쓰면 500.19 가 난다.
-->
<configuration>
  <system.webServer>

    <!-- ────────────────────────────────────────────────────────────
         MIME 타입
         기본 IIS 는 .webm 을 모른다. 등록하지 않으면 영상 24개가
         전부 404 로 떨어져 사이트가 비어 보인다.
         파일명에 해시가 없으므로 HTML 은 캐시하지 않는다
         (자산별 캐시는 아래 location 블록에서 따로 잡는다).
         ──────────────────────────────────────────────────────────── -->
    <staticContent>
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />

      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />

      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />

      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />

      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- 영상·이미지: 파일명이 고정이고 내용이 바뀌지 않는다 → 길게 캐시 -->
  <location path="assets/media">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/poster">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/brand">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- CSS·JS 는 파일명에 해시가 없어 갱신이 늦으면 안 된다 → 1시간 -->
  <location path="assets/css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
